# Google Gen AI SDK — get a key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-api-key-here
# Optional fallback, used ONLY when the primary key's daily quota is exhausted.
GOOGLE_API_KEY_2=
GEMINI_MODEL=gemini-3.1-flash-lite

# Database
# SQLite by default (zero-config, a local file). For a fully-online deployment,
# set this to a free managed Postgres URL from Neon or Supabase, e.g.:
#   DATABASE_URL=postgresql://user:pass@ep-xxx.neon.tech/neondb?sslmode=require
DATABASE_URL=sqlite:///multi_agent.db

# Email. EMAIL_ENABLED=false runs send_email in dry-run mode: messages are
# validated and logged to output/sent_emails.log but never delivered.
EMAIL_ENABLED=false

# Transport: smtp | resend | sendgrid | brevo
# SMTP is fine for low volume (Gmail caps at ~500/day). For broadcasting to many
# users prefer an HTTP API provider: higher limits and real bounce reporting.
EMAIL_PROVIDER=smtp
EMAIL_FROM=your@email.com          # From address for any provider

# Only the key for the chosen provider is needed.
RESEND_API_KEY=
SENDGRID_API_KEY=
BREVO_API_KEY=
SMTP_HOST=smtp.gmail.com
# 465 = implicit TLS (SMTPS), 587 = STARTTLS. Detected from the port; override
# with SMTP_USE_SSL=true/false only for unusual servers.
SMTP_PORT=465
SMTP_USER=your@email.com
SMTP_PASSWORD=your-app-password    # SMTP_PASS also accepted
SMTP_FROM=your@email.com

# Resume output
OUTPUT_DIR=output

# --- Access control ----------------------------------------------------------
# Required in production: the app refuses to start with ENVIRONMENT=production
# and AUTH_ENABLED=false, because that would expose the user database and the
# ability to send mail from your account.
AUTH_ENABLED=true
AUTH_USERNAME=admin
# Generate with: python -m multi_agent_system.auth
AUTH_PASSWORD_HASH=
# Plaintext alternative for local use only.
AUTH_PASSWORD=
# Signs login cookies. Required in production; generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=
AUTH_MAX_AGE=43200

# Self-service signup (first account becomes admin). Optional invite code.
AUTH_ALLOW_SIGNUP=false
AUTH_SIGNUP_CODE=
# Password-reset link lifetime (seconds) and optional public base URL.
RESET_TOKEN_TTL=1800
PUBLIC_URL=
COOKIE_SECURE=false
